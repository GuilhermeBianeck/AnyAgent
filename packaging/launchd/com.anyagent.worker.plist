<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.anyagent.worker</string>

    <key>ProgramArguments</key>
    <array>
        <string>@NODE@</string>
        <string>@WORKDIR@/worker/dist/index.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@WORKDIR@/worker</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!--
            PATH must include the locations of the AI CLIs the worker may be
            asked to spawn. launchd's default PATH is minimal, so we list the
            common installer directories explicitly:
              /Users/@USER@/.local/bin  — claude (Anthropic installer default)
              /opt/homebrew/{bin,sbin}  — Homebrew on Apple Silicon
              /usr/local/{bin,sbin}     — Homebrew on Intel / manual installs
        -->
        <key>PATH</key>
        <string>/Users/@USER@/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/@USER@</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>@WORKDIR@/worker/logs/worker.out.log</string>

    <key>StandardErrorPath</key>
    <string>@WORKDIR@/worker/logs/worker.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
