<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.anyagent.worker</string>

    <key>ProgramArguments</key>
    <array>
        <string>@NODE@</string>
        <string>@WORKDIR@/worker/dist/index.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@WORKDIR@/worker</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>@WORKDIR@/worker/logs/worker.out.log</string>

    <key>StandardErrorPath</key>
    <string>@WORKDIR@/worker/logs/worker.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
