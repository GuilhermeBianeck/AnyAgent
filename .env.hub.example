# Required
BOT_TOKEN=your_telegram_bot_token
ALLOWED_USER_ID=123456789

# WebSocket (workers connect here)
WS_PORT=8080
# REQUIRED for production — set a strong random token
WS_SECRET=change_me_to_a_random_string

# MCP Server (Claude Code, Cursor, etc. connect here)
MCP_PORT=3000
# REQUIRED to enable MCP server — set a strong random token
MCP_TOKEN=change_me_to_a_random_string

# Optional tuning
# SESSION_TIMEOUT_MS=1800000
# MAX_QUEUE_DEPTH=3

# Agent definition pinning: changes (default) | all | off
# AGENT_REVIEW=changes
