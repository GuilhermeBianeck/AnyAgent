HUB_URL=ws://localhost:8080
PAIR_CODE=your_pairing_code
# After pairing, these are auto-saved:
# NODE_ID=node_xxxxxxxx
# PRIVATE_KEY_HEX=auto_generated

# Set this to match the hub's WS_SECRET (required if hub has WS_SECRET set)
# WS_SECRET=same_as_hub

# Worker identity
WORKER_NAME=my-macbook
WORKER_DESCRIPTION=MacBook Pro - home office

# Agent declarations (v2 with capabilities)
# Configure args based on your security requirements
WORKER_AGENTS=[{"name":"claude","binary":"claude","args":[],"description":"Claude Code AI assistant","capabilities":["coding","refactoring","testing"]}]
