# Worker identity
WORKER_NAME=my-worker
WORKER_DESCRIPTION=Docker worker

# Agent declarations — configure args for your security requirements
WORKER_AGENTS=[{"name":"claude","binary":"claude","args":[],"description":"Claude Code AI assistant","capabilities":["coding","refactoring","testing"]}]
